{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sk-a2-exam.local/schemas/grammar-table.schema.json",
  "title": "Grammar Reference Table",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "level", "category", "title", "columns", "rows", "ruleIds", "exceptionIds", "tags"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "const": "grammar-table" },
    "level": { "enum": ["A1", "A2"] },
    "category": { "enum": ["persons", "verbs", "tenses", "cases", "nouns", "adjectives", "pronouns", "prepositions", "numerals", "comparison", "word-order", "other"] },
    "title": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "label": { "$ref": "#/$defs/localized" }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "minProperties": 1 }
    },
    "ruleIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "exceptionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sk", "uk"],
      "properties": {
        "sk": { "type": "string", "minLength": 1 },
        "uk": { "type": "string", "minLength": 1 }
      }
    }
  }
}
