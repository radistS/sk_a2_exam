{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sk-a2-exam.local/schemas/topic.schema.json",
  "title": "Learning Topic",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "level", "order", "status", "title", "description", "tags"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "enum": ["grammar", "vocabulary", "reading", "writing", "exam-skill"] },
    "level": { "enum": ["A1", "A2"] },
    "order": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["draft", "review", "published"] },
    "title": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sk", "uk"],
      "properties": {
        "sk": { "type": "string", "minLength": 1 },
        "uk": { "type": "string", "minLength": 1 }
      }
    }
  }
}
