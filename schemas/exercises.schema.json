{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sk-a2-exam.local/schemas/exercises.schema.json",
  "title": "Exercise Collection",
  "type": "array",
  "items": { "$ref": "#/$defs/exercise" },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["sk", "uk"],
      "properties": {
        "sk": { "type": "string", "minLength": 1 },
        "uk": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "required": ["id", "type", "level", "topicId", "difficulty", "question", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": { "enum": ["multiple-choice", "fill-gap", "choose-sentence", "translation-choice", "matching", "ordering", "true-false", "word-building", "sentence-building", "reading-comprehension", "dialogue-gap", "grammar-transformation", "writing-prompt"] },
        "level": { "enum": ["A1", "A2"] },
        "topicId": { "type": "string" },
        "difficulty": { "enum": ["easy", "medium", "exam"] },
        "question": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "correctAnswer": {},
        "acceptedAnswers": { "type": "array", "items": { "type": "string" } },
        "ruleIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "explanation": { "$ref": "#/$defs/localized" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    }
  }
}
